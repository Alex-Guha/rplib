{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "types",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false
  },
  "include": [
    "index.js",
    "defaults.js",
    "editHistory.js",
    "layout.js",
    "mutate.js",
    "panel.js",
    "renderView.js",
    "viewStore.js",
    "parser/index.js",
    "parser/parseAbstractFile.js",
    "parser/parseIntermediateFormat.js",
    "parser/serializeAbstractFormat.js",
    "parser/storage.js",
    "parser/viewStructures.js"
  ],
  "exclude": ["__tests__", "parser/__tests__", "types", "node_modules"]
}
